#!/usr/bin/env bash
set -euo pipefail

REPO="DmitryFurs/docker-magento"
BRANCH="custom"
TMPDIR=$(mktemp -d)

trap 'rm -rf "$TMPDIR"' EXIT

echo "Fetching $BRANCH branch from $REPO..."
git init -qqq "$TMPDIR/repo"
cd "$TMPDIR/repo"
git remote add origin "https://github.com/$REPO.git"
git fetch origin "$BRANCH" -qqq
git checkout "origin/$BRANCH" -- compose
cd - > /dev/null

rsync -a --delete --include='.gitignore' --exclude='.*' --exclude='src' --exclude='dumps' --exclude='ticket' "$TMPDIR/repo/compose/" ./

echo "docker-magento has been updated from $REPO@$BRANCH"
echo "Run bin/restart to apply the updates"
