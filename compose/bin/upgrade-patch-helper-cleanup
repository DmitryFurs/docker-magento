#!/usr/bin/env bash
set -euo pipefail

step() {
    echo ""
    echo "==> $1"
    echo ""
}

step "Step 1: Cleaning container artifacts"
bin/clinotty bash -c "rm -rf vendor vendor_orig vendor.patch vendor_files_to_check.patch patch-helper-output.txt classmap.json"

step "Step 2: Removing upgrade patch helper tool"
bin/rootnotty bash -c "rm -rf /var/www/upgrade-patch-helper"

step "Step 3: Rebuilding vendor from composer.lock"
bin/clinotty composer install
bin/fixowns
bin/fixperms

step "Step 4: Clearing stale generated code"
bin/clinotty bash -c "rm -rf generated/code generated/metadata"

step "Step 5: Cleaning host artifacts"
rm -rf src/vendor_orig
rm -f src/vendor.patch src/vendor_files_to_check.patch src/patch-helper-output.txt src/classmap.json
rm -f src/warnings.json src/infoNotices.json src/results.md

host_vendor_refreshed=false
if [ -d src/vendor ]; then
    step "Step 6: Refreshing host vendor copy"
    rm -rf src/vendor
    bin/copyfromcontainer vendor
    host_vendor_refreshed=true
fi

echo ""
echo "Cleanup complete!"
echo "  - Container: vendor rebuilt from composer.lock (authoritative classmap gone)"
echo "  - Container: vendor_orig/ and generated files removed"
echo "  - Container: /var/www/upgrade-patch-helper removed"
echo "  - Container: generated/code and generated/metadata cleared"
echo "  - Host: src/vendor_orig and generated files removed"
if [ "$host_vendor_refreshed" = true ]; then
    echo "  - Host: src/vendor refreshed from container"
fi
